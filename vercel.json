{
  "version": 2,
  "name": "ecoh-v2-platform",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/eCOH v2.0.apk",
      "headers": {
        "Content-Type": "application/vnd.android.package-archive",
        "Content-Disposition": "attachment; filename=\"eCOH v2.0.apk\""
      },
      "dest": "/eCOH v2.0.apk"
    },
    {
      "src": "/app",
      "dest": "/app.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
